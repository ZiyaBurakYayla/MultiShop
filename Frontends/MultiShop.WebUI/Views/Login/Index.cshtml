@model CreateLoginDto
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html lang="@lang">
<head>
    @await Html.PartialAsync("~/Views/Shared/_StitchHeadPartial.cshtml")
    <style>
        body { background-color: #6edfd9; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 font-body-md text-on-background antialiased">

    <main class="flex flex-col md:flex-row w-full max-w-4xl bg-surface-container-lowest rounded-xl shadow-2xl overflow-hidden min-h-[450px]">

        <section class="bg-primary-container text-on-primary-fixed p-10 md:w-1/2 flex flex-col justify-center">
            <h1 class="text-display-md font-display-md font-bold mb-6">MultiShop @Shared["ECommerce"]</h1>
            <div class="space-y-6 text-sm leading-relaxed">
                <p>@Shared["LoginIntro1"]</p>
                <p>@Shared["LoginIntro2"]</p>
            </div>
            <div class="mt-8">
                <a class="inline-block border border-on-primary-fixed px-4 py-1.5 font-label-md hover:bg-on-primary-fixed hover:text-primary-container transition-colors rounded" href="/Register/Index/">@Shared["Register"]</a>
            </div>
        </section>

        <section class="p-10 md:w-1/2 flex flex-col justify-center bg-surface-container-lowest">
            <h2 class="text-headline-lg font-headline-lg font-bold text-on-surface mb-8">MultiShop @Shared["LoginForm"]</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 bg-error-container text-on-error-container border border-error/30 rounded-lg px-4 py-3 text-label-sm">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form class="space-y-6" method="post">
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1" for="your_username">@Shared["Username"]</label>
                    <input class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary-container focus:border-primary-container text-on-surface transition-shadow" id="your_username" asp-for="Username" type="text" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1" for="your_password">@Shared["Password"]</label>
                    <input class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary-container focus:border-primary-container text-on-surface transition-shadow" id="your_password" asp-for="Password" type="password" required />
                </div>
                <div class="pt-2">
                    <button class="px-8 py-2.5 bg-primary-container hover:bg-primary-fixed text-on-primary-fixed font-label-md rounded-lg transition-colors shadow-sm" type="submit">@Shared["Login"]</button>
                </div>
            </form>

            <a class="mt-8 text-label-sm text-secondary hover:text-primary transition-colors" href="/Default/Index/">&larr; @Shared["Home"]</a>
        </section>

    </main>

</body>
</html>
