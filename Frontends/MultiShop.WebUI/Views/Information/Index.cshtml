@using System.Globalization
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewBag.directory1 = "MultiShop";
    ViewBag.directory3 = Localizer["PageTitle"].Value;
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<section class="max-w-container-max mx-auto px-gutter mb-section-padding">
    <div class="flex items-center gap-4 mb-8">
        <h2 class="text-headline-lg font-headline-lg text-on-surface bg-surface-container-low px-4 py-2 inline-block uppercase">@Localizer["PageTitle"]</h2>
        <div class="flex-1 h-px border-b border-dashed border-outline-variant"></div>
    </div>

    <div class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6 md:p-8 max-w-3xl">
        <h3 class="text-headline-lg font-headline-lg text-primary mb-4">@Localizer["Welcome"]</h3>
        <p class="text-body-lg font-body-lg text-secondary mb-8">@Localizer["Description"]</p>

        <div class="border-t border-surface-variant pt-6">
            <p class="font-label-md text-on-surface mb-3">@Localizer["ChooseLanguage"]</p>
            <div class="flex flex-wrap gap-2">
                <a class="border border-outline-variant text-on-surface px-4 py-2 rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-fixed hover:border-primary-container transition-colors" href="?culture=tr">Türkçe</a>
                <a class="border border-outline-variant text-on-surface px-4 py-2 rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-fixed hover:border-primary-container transition-colors" href="?culture=en">English</a>
                <a class="border border-outline-variant text-on-surface px-4 py-2 rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-fixed hover:border-primary-container transition-colors" href="?culture=de">Deutsch</a>
                <a class="border border-outline-variant text-on-surface px-4 py-2 rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-fixed hover:border-primary-container transition-colors" href="?culture=fr">Français</a>
                <a class="border border-outline-variant text-on-surface px-4 py-2 rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-fixed hover:border-primary-container transition-colors" href="?culture=it">Italiano</a>
                <a class="border border-outline-variant text-on-surface px-4 py-2 rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-fixed hover:border-primary-container transition-colors" href="?culture=ru">Русский</a>
            </div>
            <p class="text-label-sm text-secondary mt-6">
                Aktif kültür (CurrentUICulture): <b class="text-on-surface">@CultureInfo.CurrentUICulture.Name</b>
            </p>
        </div>
    </div>
</section>
