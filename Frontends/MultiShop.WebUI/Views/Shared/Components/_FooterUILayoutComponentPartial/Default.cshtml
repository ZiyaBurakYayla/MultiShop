@model List<ResultAboutDto>

<footer class="bg-inverse-surface text-on-secondary mt-auto relative">
    <div class="max-w-container-max mx-auto px-gutter py-section-padding grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-stack-md gap-y-12">
        @foreach (var item in Model)
        {
            <div class="flex flex-col gap-4">
                <h4 class="text-headline-lg-mobile font-headline-lg-mobile text-on-primary mb-2">@Shared["AboutUs"]</h4>
                <p class="text-body-md text-on-secondary-fixed-variant mb-4 leading-relaxed">@item.Description</p>
                <div class="flex items-start gap-3 text-on-secondary-fixed-variant group">
                    <span class="material-symbols-outlined text-primary-container group-hover:text-primary transition-colors">location_on</span>
                    <span class="text-body-md">@item.Address</span>
                </div>
                <div class="flex items-center gap-3 text-on-secondary-fixed-variant group cursor-pointer hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined text-primary-container group-hover:text-primary transition-colors">mail</span>
                    <span class="text-body-md">@item.Email</span>
                </div>
                <div class="flex items-center gap-3 text-on-secondary-fixed-variant group cursor-pointer hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined text-primary-container group-hover:text-primary transition-colors">call</span>
                    <span class="text-body-md">@item.Phone</span>
                </div>
            </div>
        }

        <div class="flex flex-col gap-4">
            <h4 class="text-headline-lg-mobile font-headline-lg-mobile text-on-primary mb-2">@Shared["QuickShopping"]</h4>
            <ul class="flex flex-col gap-3">
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/Default/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["Home"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/ProductList/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["OurProducts"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/ProductMarket/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> Dış Pazar</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/Discount/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["Discounts"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/ShoppingCart/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["MyCart"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/Contact/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["WriteToUs"]</a></li>
            </ul>
        </div>

        <div class="flex flex-col gap-4">
            <h4 class="text-headline-lg-mobile font-headline-lg-mobile text-on-primary mb-2">@Shared["MyAccount"]</h4>
            <ul class="flex flex-col gap-3">
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/User/Profile"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["MyProfile"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/User/MyOrder/MyOrderList"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["MyPurchases"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/ShoppingCart/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["MyCartDetails"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/User/Cargo/Index"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["Cargo"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/User/Message/Inbox"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["Messages"]</a></li>
                <li><a class="text-body-md text-on-secondary-fixed-variant hover:text-primary-container hover:translate-x-1 transition-all duration-200 flex items-center gap-2" href="/Contact/Index/"><span class="material-symbols-outlined text-[16px]">chevron_right</span> @Shared["Contact"]</a></li>
            </ul>
        </div>

        <div class="flex flex-col gap-4">
            <h4 class="text-headline-lg-mobile font-headline-lg-mobile text-on-primary mb-2">@Shared["Newsletter"]</h4>
            <p class="text-body-md text-on-secondary-fixed-variant mb-2">@Shared["NewsletterText"]</p>
            <form class="flex w-full mb-6" action="/Contact/Index" method="get">
                <input class="w-full bg-on-primary text-on-surface border-none rounded-l-lg px-4 py-3 font-body-md focus:ring-0" name="email" placeholder="@Shared["EmailPlaceholder"]" type="email" required />
                <button class="bg-primary-container text-on-primary-fixed font-label-md px-6 py-3 rounded-r-lg hover:bg-primary-fixed transition-colors whitespace-nowrap" type="submit">@Shared["Subscribe"]</button>
            </form>
            <h5 class="text-label-md text-on-primary mb-2">@Shared["FollowUs"]</h5>
            <div class="flex gap-2">
                <a class="w-10 h-10 bg-primary-container text-on-primary-fixed rounded flex items-center justify-center hover:bg-primary-fixed transition-colors" href="https://twitter.com" target="_blank"><span class="font-bold font-display-md text-[18px]">t</span></a>
                <a class="w-10 h-10 bg-primary-container text-on-primary-fixed rounded flex items-center justify-center hover:bg-primary-fixed transition-colors" href="https://facebook.com" target="_blank"><span class="font-bold font-display-md text-[18px]">f</span></a>
                <a class="w-10 h-10 bg-primary-container text-on-primary-fixed rounded flex items-center justify-center hover:bg-primary-fixed transition-colors" href="https://linkedin.com" target="_blank"><span class="font-bold font-display-md text-[18px]">in</span></a>
                <a class="w-10 h-10 bg-primary-container text-on-primary-fixed rounded flex items-center justify-center hover:bg-primary-fixed transition-colors" href="https://instagram.com" target="_blank"><span class="font-bold font-display-md text-[18px]">ig</span></a>
            </div>
        </div>
    </div>

    <div class="border-t border-white/10 bg-[#161c27]">
        <div class="max-w-container-max mx-auto px-gutter py-6 flex flex-col md:flex-row items-center justify-between gap-4">
            <p class="text-label-sm text-on-secondary-fixed-variant">
                &copy; <a class="text-primary-container font-bold" href="/Default/Index/">MultiShop</a>. @Shared["AllRightsReserved"]
            </p>
            <div class="flex gap-2 opacity-80">
                <div class="w-10 h-6 bg-white rounded flex items-center justify-center text-[10px] text-black font-bold">VISA</div>
                <div class="w-10 h-6 bg-white rounded flex items-center justify-center text-[10px] text-black font-bold">MC</div>
                <div class="w-10 h-6 bg-white rounded flex items-center justify-center text-[10px] text-black font-bold">PP</div>
                <div class="w-10 h-6 bg-white rounded flex items-center justify-center text-[10px] text-black font-bold">AMEX</div>
            </div>
        </div>
    </div>

    <button class="absolute bottom-6 right-6 w-10 h-10 bg-primary-container text-on-primary-fixed rounded flex items-center justify-center hover:bg-primary-fixed shadow-md transition-all hover:-translate-y-1" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
        <span class="material-symbols-outlined">keyboard_double_arrow_up</span>
    </button>
</footer>
