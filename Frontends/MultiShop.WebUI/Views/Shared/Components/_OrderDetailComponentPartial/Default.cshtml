<div class="lg:col-span-2">
    <div class="flex items-center gap-4 mb-4">
        <h5 class="text-headline-lg-mobile font-headline-lg-mobile text-on-surface bg-surface-container-low px-3 py-2 uppercase">@Shared["DeliveryBillingAddress"]</h5>
        <div class="flex-1 h-px border-b border-dashed border-outline-variant"></div>
    </div>

    <div class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="ms-label">@Shared["FirstName"]</label>
                <input class="ms-input" name="Name" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["LastName"]</label>
                <input class="ms-input" name="Surname" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["EmailAddress"]</label>
                <input class="ms-input" name="Email" type="email" />
            </div>
            <div>
                <label class="ms-label">@Shared["PhoneNumber"]</label>
                <input class="ms-input" name="PhoneNo" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["AddressLine1"]</label>
                <input class="ms-input" name="Detail1" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["AddressLine2"]</label>
                <input class="ms-input" name="Detail2" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["Country"]</label>
                <input class="ms-input" name="Country" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["City"]</label>
                <input class="ms-input" name="City" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["District"]</label>
                <input class="ms-input" name="District" type="text" />
            </div>
            <div>
                <label class="ms-label">@Shared["ZipCode"]</label>
                <input class="ms-input" name="ZipCode" type="text" />
            </div>
        </div>
    </div>
</div>
