@{
    ViewData["Title"] = "Ödeme";
    ViewBag.directory1 = "MultiShop";
    ViewBag.directory3 = "Ödeme";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    var cargoCompanies = ViewBag.CargoCompanies as List<ResultCargoCompanyDto>;
}

<style>
    .ms-card-container { position: relative; height: 220px; perspective: 1000px; }
    .ms-card-face { position: absolute; inset: 0; border-radius: 0.75rem; padding: 1.5rem; backface-visibility: hidden; transition: transform .6s; }
    .ms-card-front { background: linear-gradient(135deg, #2d3133 0%, #4a5058 100%); transform: rotateY(0deg); }
    .ms-card-back { background: linear-gradient(135deg, #2d3133 0%, #4a5058 100%); transform: rotateY(180deg); }
    .ms-card-container.is-flipped .ms-card-front { transform: rotateY(-180deg); }
    .ms-card-container.is-flipped .ms-card-back { transform: rotateY(0deg); }
</style>

<section class="max-w-container-max mx-auto px-gutter mb-section-padding">
    <div class="flex items-center gap-4 mb-8">
        <h2 class="text-headline-lg font-headline-lg text-on-surface bg-surface-container-low px-4 py-2 inline-block uppercase">@Shared["CompletePayment"]</h2>
        <div class="flex-1 h-px border-b border-dashed border-outline-variant"></div>
    </div>

    <div class="max-w-2xl mx-auto">
        <div class="ms-card-container mb-8" id="ms-card">
            <div class="ms-card-face ms-card-front flex flex-col justify-between text-white shadow-lg">
                <div class="flex justify-between items-start">
                    <div class="w-12 h-9 rounded bg-primary-container"></div>
                    <span class="font-display-md font-black text-primary-container text-[20px] italic">VISA</span>
                </div>
                <div class="font-display-md text-[22px] tracking-widest" id="card-number-box">################</div>
                <div class="flex justify-between items-end">
                    <div>
                        <span class="text-label-sm text-white/60 block">@Shared["CardHolder"]</span>
                        <div class="font-label-md uppercase" id="card-holder-name">ad soyad</div>
                    </div>
                    <div>
                        <span class="text-label-sm text-white/60 block">@Shared["ExpiryDate"]</span>
                        <div class="font-label-md">
                            <span id="exp-month">mm</span> / <span id="exp-year">yy</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ms-card-face ms-card-back flex flex-col justify-center text-white shadow-lg">
                <div class="h-10 bg-black/70 -mx-6 mb-6"></div>
                <div class="flex justify-end items-center gap-3">
                    <span class="text-label-sm text-white/60">Cvv</span>
                    <div class="bg-white text-black rounded px-4 py-1 min-w-[70px] text-right font-label-md" id="cvv-box"></div>
                </div>
            </div>
        </div>

        @if (TempData["PaymentError"] != null)
        {
            <div class="mb-6 bg-error-container text-on-error-container border border-error/30 rounded-lg px-4 py-3 text-label-sm">
                @TempData["PaymentError"]
            </div>
        }

        <form class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6 md:p-8 flex flex-col gap-4" asp-controller="Payment" asp-action="CompleteOrder" method="post">
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">Kargo Firması</label>
                <select class="w-full border border-outline-variant rounded-lg px-3 py-2.5 bg-surface-container-lowest text-on-surface font-body-md focus:ring-2 focus:ring-primary-container" name="cargoCompanyId" required>
                    <option value="" selected disabled>Kargo firması seçiniz</option>
                    @foreach (var company in cargoCompanies)
                    {
                        <option value="@company.CargoCompanyId">@company.CargoCompanyName</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">@Shared["CardNumber"]</label>
                <input class="w-full border border-outline-variant rounded-lg px-3 py-2.5 bg-surface-container-lowest text-on-surface font-body-md focus:ring-2 focus:ring-primary-container" id="card-number-input" name="CardNumber" maxlength="16" type="text" />
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">@Shared["CardHolder"]</label>
                <input class="w-full border border-outline-variant rounded-lg px-3 py-2.5 bg-surface-container-lowest text-on-surface font-body-md focus:ring-2 focus:ring-primary-container" id="card-holder-input" name="CardName" type="text" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1">@Shared["MonthInfo"]</label>
                    <select class="w-full border border-outline-variant rounded-lg px-3 py-2.5 bg-surface-container-lowest text-on-surface font-body-md focus:ring-2 focus:ring-primary-container" id="month-input" name="ExpirationMonth">
                        <option value="" selected disabled>@Shared["SelectMonth"]</option>
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m.ToString("00")">@m.ToString("00")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1">@Shared["YearInfo"]</label>
                    <select class="w-full border border-outline-variant rounded-lg px-3 py-2.5 bg-surface-container-lowest text-on-surface font-body-md focus:ring-2 focus:ring-primary-container" id="year-input" name="ExpirationYear">
                        <option value="" selected disabled>@Shared["SelectYear"]</option>
                        @for (int y = DateTime.Now.Year; y <= DateTime.Now.Year + 10; y++)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1">Cvv</label>
                    <input class="w-full border border-outline-variant rounded-lg px-3 py-2.5 bg-surface-container-lowest text-on-surface font-body-md focus:ring-2 focus:ring-primary-container" id="cvv-input" name="Cvv" maxlength="4" type="text" />
                </div>
            </div>
            <div class="pt-2">
                <button class="w-full bg-primary-container text-on-primary-fixed font-label-md py-3 rounded-lg hover:bg-primary-fixed transition-colors" type="submit">@Shared["CompletePayment"]</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var card = document.getElementById('ms-card');
            var numberInput = document.getElementById('card-number-input');
            var holderInput = document.getElementById('card-holder-input');
            var monthInput = document.getElementById('month-input');
            var yearInput = document.getElementById('year-input');
            var cvvInput = document.getElementById('cvv-input');

            numberInput.oninput = function () {
                document.getElementById('card-number-box').innerText = numberInput.value || '################';
            };
            holderInput.oninput = function () {
                document.getElementById('card-holder-name').innerText = holderInput.value || 'ad soyad';
            };
            monthInput.onchange = function () {
                document.getElementById('exp-month').innerText = monthInput.value;
            };
            yearInput.onchange = function () {
                document.getElementById('exp-year').innerText = yearInput.value.substring(2);
            };
            cvvInput.onfocus = function () { card.classList.add('is-flipped'); };
            cvvInput.onblur = function () { card.classList.remove('is-flipped'); };
            cvvInput.oninput = function () {
                document.getElementById('cvv-box').innerText = cvvInput.value;
            };
        })();
    </script>
}
