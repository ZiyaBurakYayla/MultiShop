@{
    ViewData["Title"] = "Ürün Detayı";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<section class="max-w-container-max mx-auto px-gutter mb-section-padding">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-12">

        @await Component.InvokeAsync("_ProductDetailImageSliderComponentPartial", new { id = ViewBag.x })

        @await Component.InvokeAsync("_ProductDetailFeatureComponentPartial", new { id = ViewBag.x })

    </div>

    <div class="bg-surface-container-lowest border border-surface-variant rounded-xl p-6 md:p-8">
        <div class="flex flex-wrap gap-2 border-b border-outline-variant mb-6" id="ms-tabs">
            <button class="ms-tab px-5 py-3 font-label-md text-secondary border-b-2 border-transparent hover:text-primary transition-colors" data-tab="tab-pane-1" type="button">@Shared["ProductDetailTab"]</button>
            <button class="ms-tab px-5 py-3 font-label-md text-secondary border-b-2 border-transparent hover:text-primary transition-colors" data-tab="tab-pane-2" type="button">@Shared["ProductInfoTab"]</button>
            <button class="ms-tab px-5 py-3 font-label-md text-secondary border-b-2 border-transparent hover:text-primary transition-colors" data-tab="tab-pane-3" type="button">@Shared["Reviews"]</button>
        </div>

        <div>
            @await Component.InvokeAsync("_ProductDetailDescriptionComponentPartial", new { id = ViewBag.x })

            @await Component.InvokeAsync("_ProductDetailInformationComponentPartial", new { id = ViewBag.x })

            @await Component.InvokeAsync("_ProductDetailReviewComponentPartial", new { id = ViewBag.x })
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var tabs = document.querySelectorAll('.ms-tab');
            var panes = document.querySelectorAll('.ms-tab-pane');
            function activate(name) {
                for (var i = 0; i < tabs.length; i++) {
                    var on = tabs[i].getAttribute('data-tab') === name;
                    tabs[i].classList.toggle('text-primary', on);
                    tabs[i].classList.toggle('border-primary', on);
                    tabs[i].classList.toggle('text-secondary', !on);
                    tabs[i].classList.toggle('border-transparent', !on);
                }
                for (var p = 0; p < panes.length; p++) {
                    panes[p].classList.toggle('hidden', panes[p].id !== name);
                }
            }
            for (var t = 0; t < tabs.length; t++) {
                (function (el) {
                    el.addEventListener('click', function () { activate(el.getAttribute('data-tab')); });
                })(tabs[t]);
            }
            activate('tab-pane-1');
        })();
    </script>
}
