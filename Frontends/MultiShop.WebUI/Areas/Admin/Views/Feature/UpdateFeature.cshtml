@model UpdateFeatureDto

@{
    ViewData["Title"] = "Öne Çıkan Alan Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">Öne Çıkan Alan Güncelleme Sayfası</h4>

    <form method="post">
        <input type="hidden" asp-for="FeatureId" />
        <div class="ms-field">
            <label class="ms-label">Öne Çıkan Alan Adı</label>
            <input class="ms-input" asp-for="Title" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Öne Çıkan Alan İkonu</label>
            <input class="ms-input" asp-for="Icon" type="text" />
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">Öne Çıkan Alanı Güncelle</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/Feature/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
