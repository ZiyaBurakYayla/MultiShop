@model List<ResultSellerDto>

@{
    ViewData["Title"] = "Satıcı Başvuruları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

@if (Model.Count == 0)
{
    <div class="ms-panel">
        <div class="ms-empty">
            <span class="material-symbols-outlined text-[48px] block mb-3">handshake</span>
            @Shared["NoPendingApplications"]
        </div>
    </div>
}
else
{
    <div class="ms-table-wrap">
        <table class="ms-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Shared["StoreName"]</th>
                    <th>@Shared["Description"]</th>
                    <th>@Shared["Seller"]</th>
                    <th class="text-right">@Shared["Actions"]</th>
                </tr>
            </thead>
            <tbody data-ms-pager="10">
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.StoreName</td>
                        <td class="max-w-md">@item.Description</td>
                        <td class="break-all">@item.OwnerUserId</td>
                        <td class="text-right whitespace-nowrap">
                            <a class="ms-btn ms-btn-sm ms-btn-primary" href="/Admin/SellerApplication/Approve/@item.SellerId">@Shared["StatusApproved"]</a>
                            <a class="ms-btn ms-btn-sm ms-btn-danger" href="/Admin/SellerApplication/Reject/@item.SellerId">@Shared["StatusRejected"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
