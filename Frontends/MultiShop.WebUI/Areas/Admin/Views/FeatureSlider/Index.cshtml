@model List<ResultFeatureSliderDto>

@{
    ViewData["Title"] = "Slider Görselleri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="flex justify-end mb-4">
    <a class="ms-btn ms-btn-primary" href="/Admin/FeatureSlider/CreateFeatureSlider/">
        <span class="material-symbols-outlined text-[20px]">add</span> Yeni Slider Görsel Girişi
    </a>
</div>

<div class="ms-table-wrap">
    <table class="ms-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Görsel</th>
                <th>Görsel Başlığı</th>
                <th class="text-right">@Shared["Actions"]</th>
            </tr>
        </thead>
        <tbody data-ms-pager="10">
            @foreach (var item in Model)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td><img class="w-20 h-12 object-cover rounded bg-surface-container-low" src="@item.ImageUrl" alt="@item.Title" /></td>
                    <td>@item.Title</td>
                    <td class="text-right whitespace-nowrap">
                        <a class="ms-btn ms-btn-sm ms-btn-ghost" href="/Admin/FeatureSlider/UpdateFeatureSlider/@item.FeatureSliderId">@Shared["Update"]</a>
                        <a class="ms-btn ms-btn-sm ms-btn-danger" href="/Admin/FeatureSlider/DeleteFeatureSlider/@item.FeatureSliderId">@Shared["Delete"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
