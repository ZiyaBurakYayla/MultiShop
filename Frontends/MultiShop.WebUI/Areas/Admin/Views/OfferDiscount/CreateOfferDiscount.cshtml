@model CreateOfferDiscountDto

@{
    ViewData["Title"] = "İndirim Teklifi Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">İndirim Teklifi Ekleme Sayfası</h4>

    <form method="post">
        <div class="ms-field">
            <label class="ms-label">İndirim Teklifi Başlığı</label>
            <input class="ms-input" asp-for="Title" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">İndirim Teklifi Alt Başlığı</label>
            <input class="ms-input" asp-for="SubTitle" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">İndirim Teklifi Görseli</label>
            <input class="ms-input" asp-for="ImageUrl" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">İndirim Teklifi Buton Başlığı</label>
            <input class="ms-input" asp-for="ButtonTitle" type="text" />
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">İndirim Teklifini Ekle</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/OfferDiscount/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
