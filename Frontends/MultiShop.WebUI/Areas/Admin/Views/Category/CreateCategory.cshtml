@model CreateCategoryDto

@{
    ViewData["Title"] = "Kategori Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">@Shared["CategoryAddPage"]</h4>

    <form method="post">
        <div class="ms-field">
            <label class="ms-label">@Shared["CategoryName"]</label>
            <input class="ms-input" asp-for="CategoryName" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["CategoryImage"]</label>
            <input class="ms-input" asp-for="ImageUrl" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Varyant Özellikleri (virgülle, örn: Renk,Beden veya Renk,Numara)</label>
            <input class="ms-input" asp-for="VariantAttributes" placeholder="Renk,Beden" type="text" />
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">@Shared["AddCategoryBtn"]</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/Category/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
