@model UpdateSpecialOfferDto

@{
    ViewData["Title"] = "Özel Teklif Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">Özel Teklif Güncelleme Sayfası</h4>

    <form method="post">
        <input type="hidden" asp-for="SpecialOfferId" />
        <div class="ms-field">
            <label class="ms-label">Teklif Başlığı</label>
            <input class="ms-input" asp-for="Title" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Teklif Alt Başlığı</label>
            <input class="ms-input" asp-for="SubTitle" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Teklif Görseli</label>
            <input class="ms-input" asp-for="ImageUrl" type="text" />
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">Özel Teklifi Güncelle</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/SpecialOffer/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
