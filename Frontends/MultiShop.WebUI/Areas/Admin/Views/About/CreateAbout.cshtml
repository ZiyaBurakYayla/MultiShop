@model CreateAboutDto

@{
    ViewData["Title"] = "Hakkımızda Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">Hakkımızda Alanı Ekleme Sayfası</h4>

    <form method="post">
        <div class="ms-field">
            <label class="ms-label">@Shared["Description"]</label>
            <input class="ms-input" asp-for="Description" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Adres</label>
            <input class="ms-input" asp-for="Address" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Email</label>
            <input class="ms-input" asp-for="Email" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Telefon</label>
            <input class="ms-input" asp-for="Phone" type="text" />
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">Hakkımızda Alanını Ekle</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/About/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
