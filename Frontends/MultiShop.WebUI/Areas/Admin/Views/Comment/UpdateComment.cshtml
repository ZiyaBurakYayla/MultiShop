@model UpdateUserCommentDto
@{
    ViewData["Title"] = "Yorum Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">Yorum Güncelleme Sayfası</h4>

    <form method="post">
        <input type="hidden" asp-for="UserCommentId" />
        <input type="hidden" asp-for="UserId" />
        <div class="ms-field">
            <label class="ms-label">Ürün Id</label>
            <input class="ms-input" asp-for="ProductId" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Kullanıcı Adı Soyadı</label>
            <input class="ms-input" asp-for="NameSurname" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Kullanıcı Görsel</label>
            <input class="ms-input" asp-for="ImageUrl" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Email Adresi</label>
            <input class="ms-input" asp-for="Email" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Kullanıcı Puanı</label>
            <input class="ms-input" asp-for="Rating" type="number" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Yorum Tarihi</label>
            <input class="ms-input" asp-for="CreatedDate" type="date" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Yorum</label>
            <textarea class="ms-textarea" asp-for="CommentDetail" rows="3"></textarea>
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">Yorumu Güncelle</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/Comment/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
