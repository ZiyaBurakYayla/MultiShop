@model UpdateCargoCompanyDto

@{
    ViewData["Title"] = "Kargo Firması Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var users = ViewBag.Users as List<ResultUserDto>;
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">Kargo Şirketi Güncelleme Sayfası</h4>

    <form method="post">
        <input type="hidden" asp-for="CargoCompanyId" />
        <div class="ms-field">
            <label class="ms-label">Kargo Şirketi Adı</label>
            <input class="ms-input" asp-for="CargoCompanyName" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">Firma Yetkilisi</label>
            <select class="ms-select" asp-for="OwnerUserId">
                <option value="">Yetkili atanmadı</option>
                @foreach (var user in users)
                {
                    <option value="@user.id">@user.name @user.surname (@user.email)</option>
                }
            </select>
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">Kargo Şirketini Güncelle</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/Cargo/CargoCompanyList/">@Shared["Back"]</a>
        </div>
    </form>
</div>
