@model CreateProductDto

@{
    ViewData["Title"] = "Ürün Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">@Shared["ImportProductTitle"]</h4>

    <div class="mb-6 bg-primary-fixed/40 text-on-primary-fixed border border-primary-container rounded-lg px-4 py-3 flex items-center gap-2 text-label-sm">
        <span class="material-symbols-outlined text-[20px]">warning</span> @Shared["ImportProductNotice"]
    </div>

    <form method="post">
        <div asp-validation-summary="All" class="mb-4 text-error text-label-sm"></div>

        <div class="ms-field">
            <label class="ms-label">@Shared["Seller"]</label>
            @Html.DropDownListFor(x => x.SellerId, (List<SelectListItem>)ViewBag.SellerValues, "-- " + @Shared["Seller"] + " --", new { @class = "ms-select" })
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["ProductName"]</label>
            <input class="ms-input" asp-for="ProductName" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["ProductPrice"]</label>
            <input class="ms-input" asp-for="ProductPrice" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["ProductImageLabel"]</label>
            <input class="ms-input" asp-for="ProductImageUrl" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["ProductCategory"]</label>
            @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.CategoryValues, new { @class = "ms-select" })
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["ProductDescription"]</label>
            <textarea class="ms-textarea" asp-for="ProductDescription" rows="5"></textarea>
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">@Shared["AddProductBtn"]</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/Product/ProductListWithCategory">@Shared["Cancel"]</a>
        </div>
    </form>
</div>
