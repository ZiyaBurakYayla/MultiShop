@model UpdateBrandDto

@{
    ViewData["Title"] = "Marka Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ms-panel max-w-3xl">
    <h4 class="ms-panel-title">@Shared["BrandUpdatePage"]</h4>

    <form method="post">
        <input type="hidden" asp-for="BrandId" />
        <div class="ms-field">
            <label class="ms-label">@Shared["BrandName"]</label>
            <input class="ms-input" asp-for="BrandName" type="text" />
        </div>
        <div class="ms-field">
            <label class="ms-label">@Shared["BrandImage"]</label>
            <input class="ms-input" asp-for="ImageUrl" type="text" />
        </div>
        <div class="flex gap-3 pt-2">
            <button class="ms-btn ms-btn-primary" type="submit">@Shared["UpdateBrandBtn"]</button>
            <a class="ms-btn ms-btn-ghost" href="/Admin/Brand/Index/">@Shared["Back"]</a>
        </div>
    </form>
</div>
