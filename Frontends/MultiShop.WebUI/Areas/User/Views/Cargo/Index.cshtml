@model List<ResultCargoDetailDto>
@{
    ViewData["Title"] = "Kargolarım";
    Layout = "~/Areas/User/Views/UserLayout/Index.cshtml";
    int count = 0;
}

<h1 class="text-headline-lg font-headline-lg text-on-surface mb-1">@Shared["MyCargos"]</h1>
<p class="text-body-md text-secondary mb-6">Siparişlerinize ait gönderileri buradan takip edebilirsiniz.</p>

@if (Model == null || Model.Count == 0)
{
    <div class="ms-empty">
        <span class="material-symbols-outlined text-[32px] text-secondary">local_shipping</span>
        <p class="text-body-md text-secondary mt-2">Henüz bir kargo kaydınız bulunmuyor.</p>
    </div>
}
else
{
    <div class="ms-table-wrap">
        <table class="ms-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Barkod</th>
                    <th>Sipariş No</th>
                    <th>Kargo Firması</th>
                    <th>Durum</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody data-ms-pager="10">
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td class="whitespace-nowrap font-mono">@item.Barcode</td>
                        <td>#@item.OrderingId</td>
                        <td>@item.CargoCompanyName</td>
                        <td>
                            @if (item.Status == "Teslim Edildi")
                            {
                                <span class="ms-badge ms-badge-gold">@item.Status</span>
                            }
                            else
                            {
                                <span class="ms-badge ms-badge-neutral">@item.Status</span>
                            }
                        </td>
                        <td class="text-right whitespace-nowrap">
                            <a class="ms-btn ms-btn-sm ms-btn-ghost" href="/User/Cargo/Track/@item.Barcode">
                                <span class="material-symbols-outlined text-[16px]">timeline</span> Takip Et
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
