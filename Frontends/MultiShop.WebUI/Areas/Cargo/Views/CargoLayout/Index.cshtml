@{
    Layout = null;
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html lang="@lang">

@await Component.InvokeAsync("_CargoLayoutHeadComponentPartial")

<body class="bg-background text-on-background font-body-md antialiased">

    <div class="flex min-h-screen">

        @await Component.InvokeAsync("_CargoLayoutSideBarComponentPartial")

        <div class="flex-1 flex flex-col min-w-0">

            @await Component.InvokeAsync("_CargoLayoutNavbarComponentPartial")

            <main class="flex-1 px-gutter py-6">
                @RenderBody()
            </main>

            @await Component.InvokeAsync("_CargoLayoutFooterComponentPartial")

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
